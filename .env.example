# Document extraction settings
POPPLER_PATH=
OCR_LANGS=en,th
TZ=Asia/Bangkok
LOG_LEVEL=INFO

# Chunking and formatting settings
DOCS_JSONL=output/stage/documents.jsonl
CHUNKS_JSONL=output/stage/chunks.jsonl
IN_JSONL=output/stage/chunks.jsonl
OUT_JSONL=output/stage/embeddable.jsonl
CHUNK_SIZE_STRUCT=512
CHUNK_OVERLAP_STRUCT=0.12
CHUNK_SIZE_OCR=256
CHUNK_OVERLAP_OCR=0.20
TEXT_KEY=
KEEP_META=1
DEDUP=none
TOKEN_MODE=approx_chars
CHAR_PER_TOKEN=3.6
MIN_TOKENS=0
MIN_CHARS=0

# Embedding, retrieval, reranking, and generation
CHROMA_PATH=chroma
COLLECTION_NAME=rag_chunks
HNSW_SPACE=cosine
EMBEDDING_MODEL=BAAI/bge-m3
BATCH_SIZE=256
RETRIEVAL_MODE=cosine
TOP_K=5
INITIAL_K=50
FINAL_K=10
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
OPENAI_MODEL=gpt-5-mini

# Configure this value locally and never commit a real key to the repository.
OPENAI_API_KEY=
